{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "revision-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--project",
        "revision",
        "revision",
        "serve",
        "--reload"
      ],
      "port": 8433
    },
    {
      "name": "revision-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "revision/frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "revision-api-test",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "REVISION_DATA_DIR=revision/data/test",
        "uv",
        "run",
        "--project",
        "revision",
        "revision",
        "serve",
        "--reload"
      ],
      "port": 8433
    }
  ]
}
